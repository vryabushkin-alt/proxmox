cat << 'EOF' > /usr/local/bin/backup 
#!/usr/bin/env python3
import os, sys, re, glob, subprocess
from datetime import datetime

# --- 1. Допоміжні функції ---

def get_all_vms():
    vms = {}
    try:
        out = subprocess.run(["qm", "list"], capture_output=True, text=True)
        for line in out.stdout.strip().split("\n")[1:]:
            parts = line.split()
            if len(parts) >= 3:
                vms[parts[0]] = {"name": parts[1], "type": "QEMU", "status": parts[2]}
        out = subprocess.run(["pct", "list"], capture_output=True, text=True)
        for line in out.stdout.strip().split("\n")[1:]:
            parts = line.split()
            if len(parts) >= 3:
                vms[parts[0]] = {"name": parts[1], "type": "LXC", "status": parts[2]}
    except Exception as e:
        print(f"Ошибка получения списка ВМ: {e}")
    return vms

def get_backup_storages():
    storages = []
    try:
        out = subprocess.run(["pvesm", "status", "-content", "backup"], capture_output=True, text=True)
        for line in out.stdout.strip().split("\n")[1:]:
            parts = line.split()
            if len(parts) >= 6 and parts[2] == "active":
                storages.append(parts[0])
    except Exception:
        pass
    return storages

def get_backup_dirs():
    dirs = set()
    storages = get_backup_storages()
    for st in storages:
        try:
            path_out = subprocess.run(["pvesm", "path", f"{st}:backup"], capture_output=True, text=True)
            if path_out.returncode == 0 and path_out.stdout.strip():
                dirs.add(path_out.stdout.strip())
        except Exception:
            pass
    dirs.add("/mnt/backups/dump")
    dirs.add("/var/lib/vz/dump")
    return [d for d in dirs if os.path.exists(d)]

def parse_backups():
    all_vms = get_all_vms()
    backup_dirs = get_backup_dirs()
    backups = []
    pattern = re.compile(r"^vzdump-(qemu|lxc)-(\d+)-(\d{4}_\d{2}_\d{2}-\d{2}_\d{2}_\d{2})\.(vma|tar)(\.(gz|lzo|zst))?$")

    for bdir in backup_dirs:
        if not os.path.exists(bdir):
            continue
        for fname in os.listdir(bdir):
            match = pattern.match(fname)
            if match:
                vm_type = match.group(1).upper()
                vmid = match.group(2)
                dt_str = match.group(3)
                
                full_path = os.path.join(bdir, fname)
                size_bytes = os.path.getsize(full_path)
                
                try:
                    dt_obj = datetime.strptime(dt_str, "%Y_%m_%d-%H_%M_%S")
                    dt_formatted = dt_obj.strftime("%d.%m.%Y %H:%M:%S")
                except ValueError:
                    dt_formatted = dt_str
                    dt_obj = datetime.min

                vm_info = all_vms.get(vmid, {"name": "Удалена", "type": vm_type, "status": "unknown"})
                base_path = re.sub(r"\.(vma|tar)(\.(gz|lzo|zst))?$", "", full_path)

                backups.append({
                    "vmid": vmid,
                    "vm_name": vm_info["name"],
                    "vm_type": vm_type,
                    "date_str": dt_formatted,
                    "dt_obj": dt_obj,
                    "size_gb": round(size_bytes / 1073741824, 2),
                    "main_file": full_path,
                    "base_path": base_path
                })

    backups.sort(key=lambda x: x["dt_obj"], reverse=True)
    for idx, b in enumerate(backups, start=1):
        b["id"] = idx

    backed_up_vmids = set(b["vmid"] for b in backups)
    no_backup_vms = []
    
    for vmid, info in all_vms.items():
        if vmid not in backed_up_vmids:
            no_backup_vms.append({
                "vmid": vmid,
                "name": info["name"],
                "type": info["type"],
                "status": info["status"]
            })
            
    no_backup_vms.sort(key=lambda x: int(x["vmid"]))
    return backups, no_backup_vms

# --- 2. Операції ---

def show_list():
    backups, no_backups = parse_backups()

    print("\n" + "=" * 90)
    print(f"{'СУЩЕСТВУЮЩИЕ БЭКАПЫ':^90}")
    print("=" * 90)
    print(f"{'ID':<5} {'VMID':<8} {'ТИП':<6} {'НАЗВАНИЕ ВМ':<22} {'ДАТА И ВРЕМЯ':<22} {'РАЗМЕР':<10}")
    print("-" * 90)

    if backups:
        for b in backups:
            size_fmt = f"{b['size_gb']} ГБ" if b['size_gb'] >= 0.1 else "< 0.1 ГБ"
            print(f"{b['id']:<5} {b['vmid']:<8} {b['vm_type']:<6} {b['vm_name']:<22} {b['date_str']:<22} {size_fmt:<10}")
    else:
        print("Бэкапы не найдены.")

    print("\n" + "=" * 90)
    print(f"{'ВМ И КОНТЕЙНЕРЫ БЕЗ БЭКАПОВ':^90}")
    print("=" * 90)
    print(f"{'VMID':<8} {'ТИП':<6} {'НАЗВАНИЕ ВМ':<22} {'СТАТУС':<15} {'ПОСЛЕДНИЙ БЭКАП':<20}")
    print("-" * 90)

    if no_backups:
        for vm in no_backups:
            print(f"{vm['vmid']:<8} {vm['type']:<6} {vm['name']:<22} {vm['status']:<15} {'НЕТ БЭКАПА':<20}")
    else:
        print("У всех виртуальных машин есть хотя бы один бэкап!")

    print("-" * 90 + "\n")

def delete_backups(ids_to_del):
    backups, _ = parse_backups()
    b_map = {b["id"]: b for b in backups}
    
    target_backups = []
    for target_id in ids_to_del:
        if target_id in b_map:
            target_backups.append(b_map[target_id])
        else:
            print(f"Ошибка: Бэкап с ID {target_id} не найден.")

    if not target_backups:
        print("Нет корректных ID для удаления.")
        return

    print("\nВы выбрали для удаления следующие бэкапы:")
    for b in target_backups:
        print(f"  [ID {b['id']}] VM {b['vmid']} ({b['vm_name']}) от {b['date_str']} — {b['main_file']}")

    confirm = input("\nВы уверены, что хотите БЕЗВОЗВРАТНО удалить их? (y/N): ").strip().lower()
    if confirm != 'y':
        print("Отмена удаления.")
        return

    for b in target_backups:
        related_files = glob.glob(f"{b['base_path']}*")
        print(f"\nУдаление бэкапа ID {b['id']} (файлов: {len(related_files)})...")
        for f in related_files:
            try:
                os.remove(f)
                print(f"  Удален: {f}")
            except Exception as e:
                print(f"  Ошибка удаления {f}: {e}")
    print("\nГотово!")

def create_backups(inputs_to_backup):
    backups, _ = parse_backups()
    all_vms = get_all_vms()
    
    b_map = {b["id"]: b["vmid"] for b in backups}
    valid_vmids = []
    
    for item in inputs_to_backup:
        try:
            val_int = int(item)
            if val_int in b_map:
                vmid = b_map[val_int]
                valid_vmids.append(vmid)
            elif str(val_int) in all_vms:
                valid_vmids.append(str(val_int))
            else:
                print(f"Ошибка: ID бэкапа или VMID '{item}' не найден.")
        except ValueError:
            print(f"Ошибка: Значение '{item}' должно быть числом.")

    if not valid_vmids:
        print("Нет корректных VMID для бэкапа.")
        return

    valid_vmids = list(dict.fromkeys(valid_vmids))

    print("\nВыберите режим бэкапа (Mode):")
    print("  1) snapshot  (Рекомендуется: без остановки ВМ на лету)")
    print("  2) suspend   (С временной заморозкой работы)")
    print("  3) stop      (С полной остановкой ВМ на время бэкапа)")
    mode_choice = input("Введите номер [1-3] (по умолчанию 1): ").strip()
    
    mode_map = {"1": "snapshot", "2": "suspend", "3": "stop", "": "snapshot"}
    selected_mode = mode_map.get(mode_choice, "snapshot")

    storages = get_backup_storages()
    if not storages:
        print("Ошибка: В Proxmox не найдено активных хранилищ с типом 'backup'.")
        return

    selected_storage = storages[0]
    if len(storages) > 1:
        print("\nДоступные хранилища для бэкапа:")
        for idx, st in enumerate(storages, 1):
            print(f"  {idx}) {st}")
        st_choice = input(f"Выберите хранилище [1-{len(storages)}] (по умолчанию 1): ").strip()
        try:
            st_idx = int(st_choice) - 1
            if 0 <= st_idx < len(storages):
                selected_storage = storages[st_idx]
        except ValueError:
            pass

    print(f"\nПараметры запуска: Режим = [{selected_mode}], Хранилище = [{selected_storage}]")
    confirm = input("Начать создание бэкапов? (Y/n): ").strip().lower()
    if confirm not in ['y', '']:
        print("Отмена операции.")
        return

    for idx, vmid in enumerate(valid_vmids, 1):
        vm_name = all_vms[vmid]["name"]
        print(f"\n========================================================")
        print(f"[{idx}/{len(valid_vmids)}] Запуск бэкапа: VM {vmid} ({vm_name})")
        print(f"========================================================\n")
        
        cmd = ["vzdump", str(vmid), "--mode", selected_mode, "--storage", selected_storage, "--compress", "zstd"]
        res = subprocess.run(cmd)
        if res.returncode == 0:
            print(f"\n Бэкап для VM {vmid} успешно создан!")
        else:
            print(f"\n Ошибка при создании бэкапа для VM {vmid}.")

# --- 3. Точка входу ---

def main():
    if len(sys.argv) == 1:
        show_list()
    elif sys.argv[1] == "del":
        if len(sys.argv) < 3:
            print("Использование: backup del <ID1> <ID2> ...")
            sys.exit(1)
        try:
            ids = [int(x) for x in sys.argv[2:]]
            delete_backups(ids)
        except ValueError:
            print("Ошибка: ID бэкапов должны быть числами.")
    elif sys.argv[1] == "new":
        if len(sys.argv) < 3:
            print("Использование: backup new <ID_или_VMID1> <ID_или_VMID2> ...")
            sys.exit(1)
        create_backups(sys.argv[2:])
    else:
        print("Неизвестная команда.")
        print("Доступные варианты:")
        print("  backup               — Показать список бэкапов и ВМ без бэкапов")
        print("  backup del 1 2 3     — Удалить бэкапы по ID")
        print("  backup new 1 301 304 — Создать новые бэкапы по ID из списка или по VMID")

if __name__ == "__main__":
    main()
